<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:bc="using:Avalonia.Data.Converters"
             xmlns:views="using:NvimManager.App.Views"
             x:Class="NvimManager.App.Views.PluginDetailView">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <DockPanel Margin="26">

      <!-- Header -->
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,4,0,18">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="&#x2190; Back to store" Classes="soft" Command="{Binding BackCommand}"
                  VerticalAlignment="Center" />
          <Path Data="{DynamicResource Icon.Heart}" Stroke="{DynamicResource Brush.Rose}"
                StrokeThickness="1.6" Fill="Transparent" StrokeJoin="Round"
                Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Category}" FontSize="12"
                     Foreground="{DynamicResource Brush.Fg.Tertiary}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <Path Data="{DynamicResource Icon.Star}" Stroke="{DynamicResource Brush.Honey}"
                  StrokeThickness="1.4" Fill="Transparent" StrokeJoin="Round"
                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StarsText}" FontSize="13" />
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
          <TextBlock Text="{Binding Repo}" Foreground="{DynamicResource Brush.Fg.Secondary}" />
          <TextBlock Text="{Binding TagsText}" FontSize="12"
                     Foreground="{DynamicResource Brush.Fg.Tertiary}" />
        </StackPanel>

        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.85" />

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
          <Button Content="Install" Classes="accent" Command="{Binding InstallCommand}"
                  IsVisible="{Binding IsInstalled, Converter={x:Static bc:BoolConverters.Not}}" />
          <Button Content="Update" Classes="accent" Command="{Binding UpdateCommand}"
                  IsVisible="{Binding IsInstalled}" />
          <Button Content="Uninstall" Classes="soft" Command="{Binding UninstallCommand}"
                  IsVisible="{Binding IsInstalled}" />
          <Button Content="Refresh metadata" Classes="soft" Command="{Binding RefreshMetadataCommand}" />
          <Button Content="Open folder" Classes="soft" Command="{Binding OpenFolderCommand}"
                  IsVisible="{Binding IsInstalled}" />
        </StackPanel>

        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource Brush.Fg.Tertiary}" />
      </StackPanel>

      <StackPanel Spacing="10">

        <!-- Lazy options -->
        <Border Classes="inset" Padding="18,14">
          <Expander Header="Lazy loading options" IsExpanded="True">
            <Grid ColumnDefinitions="170,340,170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="10" Margin="0,14,0,4">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Enabled" VerticalAlignment="Center" />
              <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" />

              <TextBlock Grid.Row="0" Grid.Column="2" Text="Lazy" VerticalAlignment="Center" />
              <CheckBox Grid.Row="0" Grid.Column="3" IsChecked="{Binding Lazy, Mode=TwoWay}" IsThreeState="True" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Version, Mode=TwoWay}" Watermark="e.g. *" />

              <TextBlock Grid.Row="1" Grid.Column="2" Text="Branch" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Branch, Mode=TwoWay}" Watermark="e.g. main" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Priority" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="2" Grid.Column="1"
                             Value="{Binding Priority, Mode=TwoWay, Converter={StaticResource NullableIntConverter}}" />

              <TextBlock Grid.Row="2" Grid.Column="2" Text="Dev (local)" VerticalAlignment="Center" />
              <CheckBox Grid.Row="2" Grid.Column="3" IsChecked="{Binding Dev, Mode=TwoWay}" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Events (one per line)" VerticalAlignment="Top" />
              <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                       Text="{Binding Events, Mode=TwoWay}" AcceptsReturn="True" MinHeight="46"
                       FontFamily="Consolas, Cascadia Code, monospace" Watermark="e.g.&#x0a;VeryLazy" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="Commands :cmd / :Coc" VerticalAlignment="Top" />
              <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                       Text="{Binding Commands, Mode=TwoWay}" AcceptsReturn="True" MinHeight="46"
                       FontFamily="Consolas, Cascadia Code, monospace" Watermark="e.g.&#x0a;Telescope" />

              <TextBlock Grid.Row="5" Grid.Column="0" Text="Filetypes ft" VerticalAlignment="Top" />
              <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"
                       Text="{Binding FileTypes, Mode=TwoWay}" AcceptsReturn="True" MinHeight="46"
                       FontFamily="Consolas, Cascadia Code, monospace" Watermark="e.g.&#x0a;lua" />

              <TextBlock Grid.Row="6" Grid.Column="0" Text="Keys (raw spec)" VerticalAlignment="Center" />
              <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3"
                       Text="{Binding Keys, Mode=TwoWay}" Watermark='e.g. {"&lt;leader&gt;ff", "&lt;c-p&gt;"}' />

              <TextBlock Grid.Row="7" Grid.Column="0" Text="Build" VerticalAlignment="Center" />
              <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3"
                       Text="{Binding Build, Mode=TwoWay}" Watermark="e.g. make" />
            </Grid>
          </Expander>
        </Border>

        <!-- Schema form -->
        <Border Classes="inset" Padding="18,14">
          <Expander Header="Plugin configuration" IsExpanded="True">
            <views:ConfigFieldsView DataContext="{Binding Config}" Margin="0,12,0,0" />
          </Expander>
        </Border>

        <!-- Raw lua -->
        <Border Classes="inset" Padding="18,14">
          <Expander Header="Raw Lua (advanced)" IsExpanded="False">
            <StackPanel Spacing="8" Margin="0,12,0,0">
              <TextBlock Text="Config function body (overrides opts application)" FontWeight="SemiBold" />
              <TextBox Text="{Binding RawConfig, Mode=TwoWay}" AcceptsReturn="True" MinHeight="70"
                       FontFamily="Consolas, Cascadia Code, monospace" TextWrapping="NoWrap" />
              <TextBlock Text="Init hook (runs before the plugin loads)" FontWeight="SemiBold" />
              <TextBox Text="{Binding RawInit, Mode=TwoWay}" AcceptsReturn="True" MinHeight="54"
                       FontFamily="Consolas, Cascadia Code, monospace" TextWrapping="NoWrap" />
            </StackPanel>
          </Expander>
        </Border>

        <!-- Preview -->
        <Border Classes="inset" Padding="18,14">
          <Expander Header="Generated spec preview" IsExpanded="False">
            <StackPanel Spacing="8" Margin="0,12,0,0">
              <Button Content="Generate preview" Classes="soft" Command="{Binding GeneratePreviewCommand}"
                      HorizontalAlignment="Left" />
              <TextBox Text="{Binding PreviewText}" AcceptsReturn="True" MinHeight="220"
                       FontFamily="Consolas, Cascadia Code, monospace" TextWrapping="NoWrap"
                       IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       IsVisible="{Binding ShowPreview}" />
            </StackPanel>
          </Expander>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,8">
          <Button Content="Save &amp; write managed config" Command="{Binding SaveAndApplyCommand}"
                  Classes="accent" />
          <ProgressBar IsIndeterminate="True" Width="140" VerticalAlignment="Center"
                       IsVisible="{Binding IsBusy}" />
        </StackPanel>

      </StackPanel>
    </DockPanel>
  </ScrollViewer>
</UserControl>