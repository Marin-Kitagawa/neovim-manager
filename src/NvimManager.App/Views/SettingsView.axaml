<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NvimManager.App.Views.SettingsView">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26" Spacing="14" MaxWidth="820" HorizontalAlignment="Left">

      <TextBlock Text="Appearance" FontSize="20" FontWeight="Bold" />

      <Border Classes="inset" Padding="18,14">
        <Grid ColumnDefinitions="150,*">
          <TextBlock Text="Theme" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}"
                    SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                    MinWidth="220" HorizontalAlignment="Left" />
        </Grid>
      </Border>

      <TextBlock Text="Neovim paths" FontSize="20" FontWeight="Bold" />

      <Border Classes="inset" Padding="18,14">
        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
          <TextBlock Text="Config dir" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding ConfigDir}"
                     FontFamily="Consolas, Cascadia Code, monospace" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Fg.Secondary}" />

          <TextBlock Grid.Row="1" Text="Data dir" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataDir}"
                     FontFamily="Consolas, Cascadia Code, monospace" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Fg.Secondary}" />

          <TextBlock Grid.Row="2" Text="Lazy root" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LazyRoot}"
                     FontFamily="Consolas, Cascadia Code, monospace" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Fg.Secondary}" />

          <TextBlock Grid.Row="3" Text="init.lua" VerticalAlignment="Center" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InitLua}"
                     FontFamily="Consolas, Cascadia Code, monospace" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Fg.Secondary}" />

          <TextBlock Grid.Row="4" Text="git" VerticalAlignment="Center" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GitPath}"
                     FontFamily="Consolas, Cascadia Code, monospace" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Fg.Secondary}" />
        </Grid>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
        <Button Content="Open config dir" Classes="soft" Command="{Binding OpenConfigDirCommand}" />
        <Button Content="Open lazy root" Classes="soft" Command="{Binding OpenLazyRootCommand}" />
        <Button Content="Open init.lua" Classes="soft" Command="{Binding OpenInitLuaCommand}" />
        <Button Content="Write managed config" Classes="accent" Command="{Binding ApplyConfigCommand}" />
        <ProgressBar IsIndeterminate="True" Width="100" VerticalAlignment="Center"
                     IsVisible="{Binding IsBusy}" />
      </StackPanel>

      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                 FontFamily="Consolas, Cascadia Code, monospace" FontSize="12"
                 Foreground="{DynamicResource Brush.Fg.Secondary}" />

      <Border Classes="inset" Padding="18,14" Margin="0,8,0,0">
        <StackPanel Spacing="6">
          <TextBlock Text="How the generated config works" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Text="{Binding AstroNote}" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Lavender}" />
          <TextBlock Text="NvimManager writes three files and never touches unrelated parts of your config:" TextWrapping="Wrap" />
          <TextBlock Text="  - lua/nvimmanager/plugins.lua  the plugin spec table"
                     FontFamily="Consolas, Cascadia Code, monospace"
                     Foreground="{DynamicResource Brush.Fg.Secondary}" />
          <TextBlock Text="  - lua/nvimmanager.lua          lazy.nvim bootstrap + setup"
                     FontFamily="Consolas, Cascadia Code, monospace"
                     Foreground="{DynamicResource Brush.Fg.Secondary}" />
          <TextBlock Text="  - init.lua                     created only when missing or already managed"
                     FontFamily="Consolas, Cascadia Code, monospace"
                     Foreground="{DynamicResource Brush.Fg.Secondary}" />
          <TextBlock Text="If you already have an init.lua, add  require(&quot;nvimmanager&quot;)  to it to activate the managed setup." TextWrapping="Wrap" />
          <TextBlock Text="Install/update actions clone plugin repos with git into the lazy root, so lazy.nvim can manage them at runtime." TextWrapping="Wrap" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>