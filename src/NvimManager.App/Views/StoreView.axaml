<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:views="using:NvimManager.App.Views"
             x:Class="NvimManager.App.Views.StoreView">

  <DockPanel Margin="22">

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,2,2,0" VerticalAlignment="Center">
      <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="Find your next favorite plugin" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="Hand-picked Neovim plugins with one-click install and cozy config."
                   Foreground="{DynamicResource Brush.Fg.Tertiary}" />
      </StackPanel>
      <views:MascotView Grid.Column="1" Width="96" Height="96" Margin="0,0,8,0" />
    </Grid>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,16">
      <TextBox Grid.Column="0" Watermark="Search the community store by name, repo, tag or description..."
               Text="{Binding SearchText, Mode=TwoWay}" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}"
                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" MinWidth="170" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <ToggleButton Content="Featured" IsChecked="{Binding FeaturedOnly}" />
        <Button Content="Refresh" Command="{Binding LoadCommand}" Classes="soft" />
      </StackPanel>
    </Grid>

    <TextBlock DockPanel.Dock="Bottom" Margin="2,10,2,0"
               Foreground="{DynamicResource Brush.Fg.Tertiary}" FontSize="12"
               Text="{Binding Plugins.Count, StringFormat={}{0} plugins in the community store}" />

    <ListBox ItemsSource="{Binding Plugins}"
             SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}"
             SelectionChanged="OnSelectionChanged"
             Background="Transparent"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Classes="glass" Margin="2,4" Padding="16,13">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18">
              <StackPanel Grid.Column="0" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Text="{Binding Repo}" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.Fg.Tertiary}" FontSize="12" />
                </StackPanel>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.82" MaxWidth="660" />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                  <TextBlock Text="{Binding TagsText}" FontSize="11"
                             Foreground="{DynamicResource Brush.Fg.Tertiary}" />
                  <TextBlock Text="{Binding Category}" FontSize="11"
                             Foreground="{DynamicResource Brush.Lavender}" />
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                  <Path Data="{DynamicResource Icon.Star}" Stroke="{DynamicResource Brush.Honey}"
                        StrokeThickness="1.4" Fill="Transparent" StrokeJoin="Round"
                        Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding StarsText}" FontSize="12" Opacity="0.9" />
                </StackPanel>
                <Border Classes="pill" Background="{DynamicResource Brush.Glass.Inset}"
                        BorderBrush="{DynamicResource Brush.Glass.BorderInset}" BorderThickness="1"
                        Padding="9,3" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Fg.Secondary}" />
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                <Button Content="Install" Classes="accent" Command="{Binding InstallCommand}" Width="108"
                        IsVisible="{Binding IsInstalled, Converter={x:Static converters:BoolConverters.Not}}"
                        IsEnabled="{Binding !IsBusy}" />
                <Button Content="Uninstall" Classes="soft" Command="{Binding UninstallCommand}" Width="108"
                        IsVisible="{Binding IsInstalled}" />
                <Button Content="Configure" Command="{Binding OpenDetailsCommand}" Width="108" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</UserControl>